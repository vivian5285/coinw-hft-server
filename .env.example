# CoinW environment
COINW_API_KEY=your_api_key_here
COINW_API_SECRET=your_api_secret_here
WEBHOOK_SECRET=your_webhook_secret_here
PORT=5004

# Trading settings
PIPELINE_SOFT_GATES=1
PIPELINE_AUDITOR_HARD_PAUSE=1
API_BUDGET_PER_MIN=48
REST_MIN_INTERVAL_SEC=2.0
HARD_STOP_BUFFER=1.15

# Telegram notification (recommended)
