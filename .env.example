# Risk settings
RISK_DAILY_LOSS_PCT=0.055
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_MAX_DAILY_TRADES=8
RISK_MAX_DRAWDOWN_PCT=0.12
CIRCUIT_BREAKER_OPEN_GATE_ENABLED=False
